generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── NextAuth ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

enum VictoryType {
  SCORE
  DOMINATION
  COALITION
}

// Whether a Hall of Fame moment celebrates a smart play or immortalizes a dumb one.
enum MomentKind {
  GLORY // a good record — smart moves, clutch wins
  TARD // "this associate really dumb" — an inside-joke blunder
}

enum MatchStage {
  GROUP
  ROUND_OF_32
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  THIRD_PLACE
  FINAL
}

enum DecidedBy {
  REGULATION
  EXTRA_TIME
  PENALTIES
}

enum MatchSlot {
  HOME
  AWAY
}

// ─── App ──────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String? // Google display name, not their Root username
  image         String?
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  claimedPlayer  Player?
  loggedGames    Game[]             @relation("LoggedBy")
  createdMoments HallOfFameMoment[] @relation("CreatedMoments")
  quinielaPicks  QuinielaPick[]
}

// Root player identity — global, not per-group
model Player {
  id        String   @id @default(cuid())
  name      String // globally unique, case-insensitive — enforced by lower(name) index in DB
  globalElo Float    @default(1000)
  createdAt DateTime @default(now())

  claimedById String? @unique // one user per player, one player per user
  claimedBy   User?   @relation(fields: [claimedById], references: [id], onDelete: SetNull)

  groups      GroupPlayer[]
  gamePlayers GamePlayer[]
}

model Group {
  id        String   @id @default(cuid())
  name      String
  joinCode  String   @unique // 8-char random alphanumeric, set on creation
  createdAt DateTime @default(now())

  players GroupPlayer[]
  games   Game[]
}

// Roster: which Players belong to which Group, and their role in it
model GroupPlayer {
  groupId  String
  playerId String
  role     Role     @default(MEMBER)
  groupElo Float    @default(1000)
  joinedAt DateTime @default(now())

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([groupId, playerId])
}

model Game {
  id             String      @id @default(cuid())
  groupId        String
  date           DateTime    @db.Date
  victoryType    VictoryType
  isVirtual      Boolean     @default(true)
  hasHirelings   Boolean     @default(false)
  createdAt      DateTime    @default(now())
  loggedByUserId String? // SetNull on user delete so games are preserved

  group    Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  loggedBy User?              @relation("LoggedBy", fields: [loggedByUserId], references: [id], onDelete: SetNull)
  players  GamePlayer[]
  moments  HallOfFameMoment[]
}

// All participants in a game; isWinner marks 1 (normal) or 2 (coalition) winners
model GamePlayer {
  id       String  @id @default(cuid())
  gameId   String
  playerId String
  faction  String // validated at app layer; string to accommodate future expansions
  isWinner Boolean @default(false)
  score    Int? // final VP; all-or-none per game, validated at app layer

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])
}

// A notable, manually-recorded moment attached to a specific game ("Hall of Fame")
model HallOfFameMoment {
  id              String     @id @default(cuid())
  gameId          String
  title           String
  description     String     @db.Text
  kind            MomentKind @default(GLORY) // glory record vs "tard" moment
  imageUrl        String? // Vercel Blob URL; optional — text is enough
  createdByUserId String? // SetNull on user delete so moments are preserved
  createdAt       DateTime   @default(now())

  game      Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy User? @relation("CreatedMoments", fields: [createdByUserId], references: [id], onDelete: SetNull)
}

// ─── Quinielas (World Cup prediction pool) ────────────────────────────────────
// Global, hidden feature — not linked from the main app nav. See src/app/quinielas.

model Match {
  id          String     @id @default(cuid())
  matchNumber Int        @unique // FIFA official match number
  stage       MatchStage
  groupName   String? // "A".."L", group stage only

  // Team slots: exactly one of team/placeholder is set per side until the
  // placeholder resolves (e.g. "Winner Match 73" -> concrete team name).
  homeTeam            String?
  homeTeamPlaceholder String?
  awayTeam            String?
  awayTeamPlaceholder String?

  kickoffAt DateTime // stored UTC; displayed in America/Mexico_City in the UI
  venue     String?

  // Actual result, entered once the match ends.
  homeScore        Int?
  awayScore        Int?
  decidedBy        DecidedBy?
  penaltyHomeScore Int?
  penaltyAwayScore Int?
  winnerTeam       String? // null until decided; stays null for group-stage draws

  // Knockout bracket advancement: winner of this match fills a slot in nextMatch.
  nextMatchId   String?
  nextMatchSlot MatchSlot?
  nextMatch     Match?     @relation("MatchAdvancement", fields: [nextMatchId], references: [id])
  feedsInto     Match[]    @relation("MatchAdvancement")

  // Semifinals only: loser fills a slot in the third-place match.
  loserNextMatchId   String?
  loserNextMatchSlot MatchSlot?
  loserNextMatch     Match?     @relation("MatchLoserAdvancement", fields: [loserNextMatchId], references: [id])
  loserFeedsInto     Match[]    @relation("MatchLoserAdvancement")

  createdAt DateTime @default(now())

  picks QuinielaPick[]
}

// One user's prediction for one match.
model QuinielaPick {
  id               String    @id @default(cuid())
  matchId          String
  userId           String
  homeScore        Int
  awayScore        Int
  decidedBy        DecidedBy @default(REGULATION)
  penaltyHomeScore Int?
  penaltyAwayScore Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}
