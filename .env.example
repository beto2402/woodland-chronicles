# Neon — get both from your Neon project dashboard → Connection Details
DATABASE_URL=
DIRECT_URL=

# NextAuth
NEXTAUTH_SECRET=

# Google OAuth — from Google Cloud Console → APIs & Services → Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Shared secret checked by /api/cron/seasons (Vercel Cron sends this as a bearer token). Must
# also be set in the Vercel project's env vars.
CRON_SECRET=
